{
  // Académie Limitless : Worker avec fichiers statiques et API de connexion
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "academielimitless",
  "main": "src/worker.js",
  "compatibility_date": "2025-07-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "keep_vars": true,
  "kv_namespaces": [{ "binding": "ACADEMIE", "id": "b2117f29a2464d31bd5d478066c80e43" }],
  "observability": { "enabled": true }
}
